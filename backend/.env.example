PGUSER=postgres
PGHOST=localhost
PGDATABASE=microbanking
PGPASSWORD=your_postgres_password
PGPORT=5432
# true only for hosted databases (e.g. Railway)
PGSSL=false

# Use a long random string, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
PORT=5000
# Comma-separated list of frontend URLs allowed to call the API
CORS_ORIGIN=http://localhost:3000
# Failed login attempts allowed per IP per 15 minutes
LOGIN_RATE_LIMIT=10

# Interest: cron schedules and the time between credits for each account
FD_INTEREST_CRON=0 3 * * *
SAVINGS_INTEREST_CRON=30 3 * * *
INTEREST_CYCLE=30 days
# INTEREST_CRON_DEBUG=1 runs both jobs every 10 seconds with a 1 minute cycle (demos only)
INTEREST_CRON_DEBUG=0

SUPPRESS_GENERAL_LOGS=1
